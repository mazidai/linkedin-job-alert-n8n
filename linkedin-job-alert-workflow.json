    {
      "parameters": {
        "jsCode": "const run = $input.first().json.data || {};\nconst status = run.status;\nconst MAX_WAIT_MS = 15 * 60 * 1000; // give up after 15 minutes\nlet route = 'wait';\nlet reason = '';\n\nif (status === 'SUCCEEDED') {\n  route = 'success';\n} else if (['FAILED', 'ABORTED', 'TIMED-OUT'].includes(status)) {\n  route = 'failed';\n  reason = run.statusMessage || ('Apify run ended with status ' + status);\n} else if (run.startedAt && Date.now() - new Date(run.startedAt).getTime() > MAX_WAIT_MS) {\n  route = 'failed';\n  reason = 'Run did not finish within 15 minutes (last status: ' + status + ')';\n}\n\nreturn [{ json: { route, status, reason, runId: run.id, datasetId: run.defaultDatasetId } }];"
      },
