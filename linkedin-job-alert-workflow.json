      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst reason = j.reason\n  || (j.error && (j.error.message || JSON.stringify(j.error)))\n  || j.message\n  || 'Unknown error';\nlet search = '';\ntry {\n  const s = $('Validate Input').first().json;\n  search = s.jobTitle + ' | ' + s.location + ' | ' + s.limit;\n} catch (e) {}\n\nreturn [{ json: {\n  time: new Date().toISOString(),\n  runId: j.runId || '',\n  status: j.status || 'REQUEST_FAILED',\n  reason,\n  search\n} }];"
