      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst jobTitle = String(b.jobTitle || '').trim();\nconst location = String(b.location || '').trim();\nconst errors = [];\nlet limit = b.limit === undefined || b.limit === '' ? 20 : parseInt(b.limit, 10);\n\nif (!jobTitle) errors.push('jobTitle is required');\nif (!location) errors.push('location is required');\nif (!Number.isInteger(limit) || limit < 1) errors.push('limit must be a positive integer');\nif (limit > 200) limit = 200; // safety cap to control Apify cost\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    jobTitle,\n    location,\n    limit,\n    // r86400 = last 24h, r604800 = last 7 days, r2592000 = last 30 days\n    publishedAt: b.publishedAt || 'r604800',\n    // Apify actor ID (use \"~\" instead of \"/\" in the API URL)\n    actorId: 'curious_coder~linkedin-jobs-scraper',\n    searchUrl: 'https://www.linkedin.com/jobs/search/?keywords=' + encodeURIComponent(jobTitle) + '&location=' + encodeURIComponent(location) + '&f_TPR=' + (b.publishedAt || 'r604800') + '&position=1&pageNum=0',\n    scrapeCount: Math.max(10, limit) // this actor needs count >= 10\n  }\n}];"
      },
