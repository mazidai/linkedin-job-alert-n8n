    {
      "parameters": {
        "jsCode": "const rows = $('Process Data').all().map(i => i.json);\nconst top = (key, n = 5) => {\n  const m = {};\n  rows.forEach(r => { const v = r[key]; if (v) m[v] = (m[v] || 0) + 1; });\n  return Object.entries(m).sort((a, b) => b[1] - a[1]).slice(0, n)\n    .map(([k, v]) => k + ' (' + v + ')').join(', ');\n};\nconst search = $('Validate Input').first().json;\nconst titles = rows.slice(0, 15).map(r => r['Job Title']).join('; ');\n\nconst prompt =\n  'You are a recruitment analyst. Using the data below, write a 2-3 sentence summary that highlights: ' +\n  '(1) the most common hiring companies, (2) the most common locations, (3) any noticeable hiring trends. ' +\n  'Be concise and factual. Do not invent numbers.\\n\\n' +\n  'Search: \"' + search.jobTitle + '\" in \"' + search.location + '\"\\n' +\n  'Total jobs: ' + rows.length + '\\n' +\n  'Top companies: ' + top('Company Name') + '\\n' +\n  'Top locations: ' + top('Location') + '\\n' +\n  'Sample job titles: ' + titles;\n\nreturn [{ json: { prompt, total: rows.length } }];"
      },
