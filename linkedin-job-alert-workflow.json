    {
      "parameters": {
        "jsCode": "const clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst noQuery = u => clean(u).split('?')[0]; // drop LinkedIn tracking params\nconst seen = new Set();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const url = noQuery(j.link || j.jobUrl || j.url || j.applyUrl);\n  const title = clean(j.title || j.jobTitle);\n  if (!url || !title || seen.has(url)) continue; // skip junk + duplicates\n  seen.add(url);\n  out.push({\n    json: {\n      'Job Title': title,\n      'Company Name': clean(j.companyName || j.company),\n      'Location': clean(j.location),\n      'Posted Time': clean(j.postedAt || j.postedTime || j.timeAgo || j.postedText || j.publishedAt),\n      'Job URL': url,\n      'Company URL': noQuery(j.companyLinkedinUrl || j.companyUrl), // empty if not available\n      'Scraped At': new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },
